{
  "name": "mythix-orm-postgresql",
  "version": "1.13.0",
  "description": "PostgreSQL driver for Mythix ORM",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "coverage": "clear ; ./scripts/run-tests.sh --coverage",
    "test": "./scripts/run-tests.sh",
    "test:raw": "node ./node_modules/.bin/jasmine",
    "test-debug": "node --inspect-brk ./node_modules/.bin/jasmine",
    "test-watch": "watch 'clear ; ./scripts/run-tests.sh' . --wait=2 --interval=1",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th317erd/mythix-orm-postgresql.git"
  },
  "keywords": [
    "orm",
    "mysql",
    "postgres",
    "postgresql",
    "mssql",
    "mongo",
    "snowflake",
    "database",
    "sql",
    "no-sql"
  ],
  "author": "Wyatt Greenway",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/th317erd/mythix-orm-postgresql/issues"
  },
  "homepage": "https://github.com/th317erd/mythix-orm-postgresql#readme",
  "peerDependencies": {
    "mythix-orm": "^1.14.1",
    "mythix-orm-sql-base": "^1.12.1"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "nife": "^1.12.1",
    "pg": "^8.16.0",
    "pg-format": "^1.0.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@spothero/eslint-plugin-spothero": "github:spothero/eslint-plugin-spothero",
    "eslint": "^8.57.1",
    "jasmine": "^5.6.0",
    "nyc": "^17.1.0"
  },
  "nyc": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "spec/**",
      "lib/proxy-class/proxy-class.js"
    ]
  }
}
